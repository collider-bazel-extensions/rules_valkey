"""Full E2E install smoke for valkey_install with a custom config.

Composition (3-link itest dep chain):
  kind_svc → valkey_install_svc → smoke_test

Installs into namespace `cache` (not the default `valkey`, to check
`namespace` is honoured) with the in-tree test config, then checks it in
the pod and through the Service from a second pod.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_valkey//:defs.bzl", "valkey_install", "valkey_install_health_check")

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    # Let rules_kind finish `kind delete` itself instead of leaving it to
    # its reaper after the test (rules_itest's default is 1s).
    shutdown_timeout = "300s",
    tags = ["manual"],
)

valkey_install(
    name = "valkey_install_bin",
    config = "//tests/testdata:install_config",
    namespace = "cache",
    tags = ["manual"],
)

valkey_install_health_check(
    name = "valkey_health_bin",
    namespace = "cache",
    tags = ["manual"],
)

sh_binary(
    name = "valkey_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":valkey_install_bin"],
)

sh_binary(
    name = "valkey_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":valkey_health_bin"],
)

itest_service(
    name = "valkey_install_svc",
    exe = ":valkey_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":valkey_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":valkey_install_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
