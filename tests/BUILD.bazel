"""In-tree tests for rules_valkey (no container runtime needed; the
cluster install smoke lives in tests/install_smoke)."""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "@rules_valkey//:defs.bzl",
    "valkey_health_check",
    "valkey_install",
    "valkey_server",
    "valkey_test",
)
load(":analysis_tests.bzl", "analysis_test_suite")

_SEED = ["//tests/testdata:seed.valkey"]

# ---- config -----------------------------------------------------------------

# The validation action, run directly on good and bad configs.
sh_test(
    name = "config_check_test",
    srcs = ["config_check_test.sh"],
    args = [
        "$(rootpath //private:launcher.py)",
        "$(rootpath //tests/testdata:valkey.conf)",
        "$(rootpaths //toolchain:current)",
    ],
    data = [
        "//private:launcher.py",
        "//tests/testdata:bad.acl",
        "//tests/testdata:bad_directive.conf",
        "//tests/testdata:bad_value.conf",
        "//tests/testdata:users.acl",
        "//tests/testdata:valkey.conf",
        "//toolchain:current",
    ],
)

# ---- hermetic server ----------------------------------------------------------

valkey_test(
    name = "api_test",
    srcs = ["api_test.sh"],
    args = [
        "one",
        "'two words'",
    ],
    config = "//tests/testdata:config",
    seed = _SEED,
)

valkey_test(
    name = "password_test",
    srcs = ["password_test.sh"],
    password = "s3cret pass",
    seed = _SEED,
)

valkey_test(
    name = "cluster_test",
    srcs = ["cluster_test.sh"],
    replicas = 1,
    seed = _SEED,
    shards = 3,
)

valkey_test(
    name = "rdb_test",
    srcs = ["rdb_test.sh"],
    rdb = "//tests/testdata:dump.rdb",
)

valkey_server(
    name = "test_server",
    extra_args = [
        "--maxmemory",
        "32mb",
    ],
    seed = _SEED,
    tags = ["manual"],
)

valkey_health_check(
    name = "test_server_health",
    server = ":test_server",
    tags = ["manual"],
)

sh_test(
    name = "server_test",
    srcs = ["server_test.sh"],
    args = ["$(rootpath :test_server)"],
    data = [":test_server"],
)

sh_test(
    name = "health_check_test",
    srcs = ["health_check_test.sh"],
    args = ["$(rootpath :test_server_health)"],
    data = [":test_server_health"],
)

valkey_server(
    name = "bad_flag_server",
    extra_args = ["--no-such-option"],
    tags = ["manual"],
)

valkey_server(
    name = "bad_seed_server",
    seed = ["//tests/testdata:bad_seed.valkey"],
    tags = ["manual"],
)

valkey_server(
    name = "slow_server",
    ready_timeout = "0.001",
    tags = ["manual"],
)

valkey_test(
    name = "failing_valkey_test",
    srcs = ["never_runs.sh"],
    extra_args = ["--no-such-option"],
    tags = ["manual"],
)

sh_test(
    name = "server_failure_test",
    srcs = ["server_failure_test.sh"],
    args = [
        "$(rootpath :bad_flag_server)",
        "$(rootpath :bad_seed_server)",
        "$(rootpath :slow_server)",
        # failing_valkey_test's trampoline, run with the arguments its
        # sh_test would pass (a test target's args don't apply as data).
        "$(rootpath //private:valkey_test_trampoline.sh)",
        "$(rootpath :failing_valkey_test_valkey)",
        "$(rootpath :failing_valkey_test_inner)",
        "$(rootpath //private:testlib.sh)",
    ],
    data = [
        ":bad_flag_server",
        ":bad_seed_server",
        ":failing_valkey_test_inner",
        ":failing_valkey_test_valkey",
        ":slow_server",
        "//private:testlib.sh",
        "//private:valkey_test_trampoline.sh",
    ],
)

valkey_test(
    name = "record_port",
    srcs = ["record_port.sh"],
    tags = ["manual"],
)

sh_test(
    name = "server_cleanup_test",
    srcs = ["server_cleanup_test.sh"],
    args = [
        "$(rootpath //private:valkey_test_trampoline.sh)",
        "$(rootpath :record_port_valkey)",
        "$(rootpath :record_port_inner)",
        "$(rootpath //private:testlib.sh)",
    ],
    data = [
        ":record_port_inner",
        ":record_port_valkey",
        "//private:testlib.sh",
        "//private:valkey_test_trampoline.sh",
    ],
)

# valkey_server as a rules_itest service.
valkey_server(
    name = "itest_server",
    seed = _SEED,
    tags = ["manual"],
)

valkey_health_check(
    name = "itest_server_health",
    server = ":itest_server",
    tags = ["manual"],
)

itest_service(
    name = "valkey_svc",
    exe = ":itest_server",
    health_check = ":itest_server_health",
    tags = ["manual"],
)

sh_test(
    name = "itest_test_bin",
    srcs = ["itest_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "itest_test",
    services = [":valkey_svc"],
    test = ":itest_test_bin",
)

# ---- cluster install manifest -------------------------------------------------

valkey_install(
    name = "configured_install",
    config = "//tests/testdata:install_config",
    tags = ["manual"],
)

sh_test(
    name = "install_config_test",
    srcs = ["install_config_test.sh"],
    args = [
        "$(rootpath //private/manifests:valkey.yaml)",
        "$(rootpath :configured_install_manifest)",
    ],
    data = [
        ":configured_install_manifest",
        "//private/manifests:valkey.yaml",
    ],
)

sh_test(
    name = "checksums_test",
    srcs = ["checksums_test.sh"],
    data = ["//private:conda_versions.bzl"],
)

analysis_test_suite(name = "analysis_tests")
