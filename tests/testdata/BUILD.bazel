load("@rules_valkey//:defs.bzl", "valkey_config")

package(default_visibility = ["//tests:__subpackages__"])

exports_files(glob(["**"]))

# The production-shaped config: host paths overridden, ACL file supplied.
valkey_config(
    name = "config",
    src = "valkey.conf",
    acl = "users.acl",
)

# The same settings without the ACL file (aclfile line dropped), for the
# cluster install, whose pre-rendered chart mounts only valkey.conf.
genrule(
    name = "install_conf",
    srcs = ["valkey.conf"],
    outs = ["install/valkey.conf"],
    cmd = "grep -v '^aclfile' $< > $@",
)

valkey_config(
    name = "install_config",
    src = ":install_conf",
)

# Persistence variants for restart tests.
valkey_config(
    name = "no_persistence",
    src = "no_persistence.conf",
)

valkey_config(
    name = "aof",
    src = "aof.conf",
)

# Your-own-certificates TLS fixtures, made at build time with the
# toolchain's openssl (valid 10 years: build outputs are cached).
genrule(
    name = "certs",
    outs = [
        "certs/ca.crt",
        "certs/server.crt",
        "certs/server.key",
        "certs/client.crt",
        "certs/client.key",
    ],
    cmd = "$(location //tests:make_certs.sh) $(@D)/certs $(locations //toolchain:current)",
    tools = [
        "//tests:make_certs.sh",
        "//toolchain:current",
    ],
)
