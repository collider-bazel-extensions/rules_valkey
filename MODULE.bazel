"""rules_valkey — hermetic Valkey primitives for Bazel.

Three families in one repo:

  Config (build time):
    valkey_config          — valkey.conf (+ ACL file); valkey-server itself
                             loads it as a validation action on every build

  Hermetic server (test-time):
    valkey_server          — long-running valkey-server (standalone, or a
                             sharded cluster); writes $TEST_TMPDIR/<name>.env
                             once it answers and is seeded
    valkey_health_check    — pairs with valkey_server
    valkey_test            — sh_test macro: auto-launched server

  Cluster install (kind / production-shaped):
    valkey_install / valkey_install_health_check — the pinned official
                             valkey-io Helm chart, optionally with your config

Pinned: Valkey 9.1.3 (conda-forge valkey-server closure), valkey-io
`valkey` Helm chart 0.12.1.
"""

module(
    name = "rules_valkey",
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# rules_shell is part of the public surface — valkey_test is an sh_test
# macro. Bazel 8+ removed `native.sh_test`.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Public binary toolchain. Per-platform repos (valkey_<ver>_<plat>) come
# from the `valkey` extension, which only honours the root module's tags —
# consumers declare the same version.
valkey = use_extension("//:extensions.bzl", "valkey")
valkey.version(version = "9.1.3")
use_repo(
    valkey,
    "valkey_9_1_3_darwin_amd64",
    "valkey_9_1_3_darwin_arm64",
    "valkey_9_1_3_linux_amd64",
    "valkey_9_1_3_linux_arm64",
)
register_toolchains("@rules_valkey//toolchain:all")

# rules_kubectl is a public dep — valkey_install is a thin macro around
# `kubectl_apply`.
bazel_dep(name = "rules_kubectl", version = "0.2.0")
git_override(
    module_name = "rules_kubectl",
    remote = "https://github.com/collider-bazel-extensions/rules_kubectl",
    commit = "81b60ab80df46b64c612f2576ffef0a7af98ccb6",  # v0.2.0
)

# ---- dev-only: maintainer chart-render flow + smoke composition -------------

bazel_dep(name = "rules_helm", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_helm",
    remote = "https://github.com/collider-bazel-extensions/rules_helm",
    commit = "48651387d55f0c50f6d059df246ed73767100afb",  # v0.2.1
)

helm = use_extension("@rules_helm//:extensions.bzl", "helm", dev_dependency = True)
helm.version(version = "3.20.2")
use_repo(
    helm,
    "helm_darwin_amd64",
    "helm_darwin_arm64",
    "helm_linux_amd64",
)
register_toolchains(
    "@helm_linux_amd64//:toolchain",
    "@helm_darwin_amd64//:toolchain",
    "@helm_darwin_arm64//:toolchain",
    dev_dependency = True,
)

bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.3.0", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "12a73e02fe4b9400d3dc733a3d80ce06c47b6411",  # v0.3.0 — confirmed deletion + sweep, RULES_KIND_MAX_CLUSTERS
)

# Maintainer-side: download the upstream Helm chart .tgz at the pinned
# version. Fires only when rules_valkey is the root module.
valkey_chart = use_extension("//tools:extensions.bzl", "valkey_chart", dev_dependency = True)
valkey_chart.version(version = "0.12.1")
use_repo(valkey_chart, "valkey_chart_0_12_1")
