load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":toolchain.bzl", "current_valkey_toolchain", "valkey_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchain.bzl"])

toolchain_type(name = "valkey")

# The resolved binaries + libraries for the target platform, usable as `data`.
current_valkey_toolchain(name = "current")

# Per-platform toolchains. Each `valkey_<ver>_<plat>` repo (created by the
# module extension) holds one platform's conda-forge closure.

valkey_toolchain(
    name      = "valkey_linux_amd64_impl",
    version   = "9.1.3",
    server    = "@valkey_9_1_3_linux_amd64//:valkey_server",
    cli       = "@valkey_9_1_3_linux_amd64//:valkey_cli",
    check_rdb = "@valkey_9_1_3_linux_amd64//:valkey_check_rdb",
    check_aof = "@valkey_9_1_3_linux_amd64//:valkey_check_aof",
    openssl   = "@valkey_9_1_3_linux_amd64//:openssl",
    libs      = "@valkey_9_1_3_linux_amd64//:libs",
)

toolchain(
    name                   = "valkey_linux_amd64",
    toolchain_type         = ":valkey",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain              = ":valkey_linux_amd64_impl",
)

valkey_toolchain(
    name      = "valkey_linux_arm64_impl",
    version   = "9.1.3",
    server    = "@valkey_9_1_3_linux_arm64//:valkey_server",
    cli       = "@valkey_9_1_3_linux_arm64//:valkey_cli",
    check_rdb = "@valkey_9_1_3_linux_arm64//:valkey_check_rdb",
    check_aof = "@valkey_9_1_3_linux_arm64//:valkey_check_aof",
    openssl   = "@valkey_9_1_3_linux_arm64//:openssl",
    libs      = "@valkey_9_1_3_linux_arm64//:libs",
)

toolchain(
    name                   = "valkey_linux_arm64",
    toolchain_type         = ":valkey",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain              = ":valkey_linux_arm64_impl",
)

valkey_toolchain(
    name      = "valkey_darwin_amd64_impl",
    version   = "9.1.3",
    server    = "@valkey_9_1_3_darwin_amd64//:valkey_server",
    cli       = "@valkey_9_1_3_darwin_amd64//:valkey_cli",
    check_rdb = "@valkey_9_1_3_darwin_amd64//:valkey_check_rdb",
    check_aof = "@valkey_9_1_3_darwin_amd64//:valkey_check_aof",
    openssl   = "@valkey_9_1_3_darwin_amd64//:openssl",
    libs      = "@valkey_9_1_3_darwin_amd64//:libs",
)

toolchain(
    name                   = "valkey_darwin_amd64",
    toolchain_type         = ":valkey",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    toolchain              = ":valkey_darwin_amd64_impl",
)

valkey_toolchain(
    name      = "valkey_darwin_arm64_impl",
    version   = "9.1.3",
    server    = "@valkey_9_1_3_darwin_arm64//:valkey_server",
    cli       = "@valkey_9_1_3_darwin_arm64//:valkey_cli",
    check_rdb = "@valkey_9_1_3_darwin_arm64//:valkey_check_rdb",
    check_aof = "@valkey_9_1_3_darwin_arm64//:valkey_check_aof",
    openssl   = "@valkey_9_1_3_darwin_arm64//:openssl",
    libs      = "@valkey_9_1_3_darwin_arm64//:libs",
)

toolchain(
    name                   = "valkey_darwin_arm64",
    toolchain_type         = ":valkey",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    toolchain              = ":valkey_darwin_arm64_impl",
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = ["//private:providers"],
)
